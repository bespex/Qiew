{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cusq",
  "mainBinaryName": "cusq",
  "version": "0.4.0",
  "identifier": "net.spex.cusq",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cusq",
        "width": 920,
        "height": 1000,
        "minWidth": 360,
        "minHeight": 240,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "csv"
        ],
        "name": "CSV",
        "description": "CSV table",
        "role": "Viewer",
        "mimeType": "text/csv"
      },
      {
        "ext": [
          "tsv"
        ],
        "name": "TSV",
        "description": "TSV table",
        "role": "Viewer",
        "mimeType": "text/tab-separated-values"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "cusq.desktop"
      }
    },
    "createUpdaterArtifacts": true,
    "shortDescription": "CSV viewer, read-only – be spex",
    "longDescription": "Cusq lays a CSV or TSV file out as a table you can sort, filter and search,\nso whoever just wants to look at the data does not have to start a\nspreadsheet program. The window takes the width the table needs.\n\nOne of the Qiew viewers of be spex – apps for the way you work:\nhttps://bespex.github.io"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5N0MxRTlFMjlGN0FCNkQKUldSdHEvY3BuaDU4dVJ4WVlqTll2b25sMmdhUlVjNXJhZDFZMEZNU3RxeVlqdXRZWlJyeGdsbUoK",
      "endpoints": [
        "https://github.com/bespex/Qiew/releases/download/updater/cusq.json"
      ]
    }
  }
}
